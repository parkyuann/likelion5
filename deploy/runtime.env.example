# Server-side runtime template. Inject real credentials and provisioned assets
# outside Git; placeholders below are intentionally non-functional.
APP_RUNTIME_MODE=ec2_overlay
APPLICATION_DATABASE_URL=postgresql://<application-user>:<password>@postgres:5432/application
APPLICATION_SCHEMA_STATUS=VERIFIED
APPLICATION_SCHEMA_REVISION=001_application_auth
KOSIS_METADATA_DATABASE_URL=postgresql://<metadata-user>:<password>@postgres:5432/kosis_metadata
REDIS_SESSION_URL=redis://:<password>@redis-session:6379/0
AUTH_ALLOWED_ORIGINS=https://<your-domain>
AUTH_SESSION_TTL_SECONDS=604800
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_COOKIE_NAME=__Host-kosis_session
OPENSEARCH_URL=http://opensearch:9200
KOSIS_RELEASE_ID=<KOSIS_RELEASE_ID>
KOSIS_BM25_ANALYZER=standard-v1
KOSIS_BM25_INDEX=<KOSIS_BM25_INDEX>
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=<QDRANT_COLLECTION>
QDRANT_VECTOR_SIZE=1024
QDRANT_VECTOR_NAME=
QDRANT_RECEIPT_SHA256=<QDRANT_RECEIPT_SHA256>
KOSIS_REDIS_CACHE_ENABLED=false
KOSIS_REDIS_CACHE_URL=
BGE_QUERY_ENCODER_ENABLED=true
BGE_QUERY_ENCODER_URL=http://bge-query-encoder:8101
BGE_QUERY_ENCODER_CONTRACT=bge-m3-ko-query-encoder-service-v2
BGE_QUERY_ENCODER_MODEL_ID=<BGE_QUERY_ENCODER_MODEL_ID>
BGE_QUERY_ENCODER_MODEL_REVISION=<BGE_QUERY_ENCODER_MODEL_REVISION>
BGE_QUERY_ENCODER_VECTOR_SIZE=1024
BGE_QUERY_ENCODER_MODEL_RECEIPT_SHA256=<BGE_QUERY_ENCODER_MODEL_RECEIPT_SHA256>
BGE_QUERY_ENCODER_TIMEOUT_SECONDS=3
BGE_QUERY_ENCODER_TOKEN_FILE=/run/secrets/bge_query_encoder_token
BGE_QUERY_ENCODER_TOKEN_SOURCE=<server-only-secret-path>
BGE_QUERY_ENCODER_MODEL_SOURCE=<server-only-model-path>
BGE_QUERY_ENCODER_MODEL_RECEIPT_SOURCE=<server-only-receipt-path>
BGE_QUERY_ENCODER_CLOSURE_MANIFEST_SOURCE=<server-only-closure-manifest-path>
KOSIS_HYBRID_PATH_TOP_K=100
KOSIS_HYBRID_FUSION_TOP_K=100
KOSIS_HYBRID_RRF_K=60
BGE_RERANKER_ENABLED=false
PIPELINE_RUNTIME_ENABLED=true
PIPELINE_LIVE_STAGE_ENABLED=false
PIPELINE_NATURAL_QUERY_ENABLED=false
PIPELINE_IMAGE_ENABLED=false
PIPELINE_URL_ENABLED=false
PIPELINE_EARLY_CLARIFICATION_ENABLED=true
PIPELINE_BINDING_RESUME_ENABLED=true
PIPELINE_CLARIFICATION_OPTIONS_ENABLED=true
PIPELINE_REQUEST_CACHE_ENABLED=true
PIPELINE_SPECULATIVE_RETRIEVAL_ENABLED=true
PIPELINE_TIMING_RECEIPT_ENABLED=true
PIPELINE_ANSWER_RENDER_MODE=DETERMINISTIC_ONLY
PIPELINE_HCX_ANSWER_TIMEOUT_SECONDS=3.0
PIPELINE_SPECULATIVE_DEADLINE_MS=2500
NGINX_TLS_CERT_SOURCE=<server-only-tls-certificate-path>
NGINX_TLS_KEY_SOURCE=<server-only-tls-private-key-path>
