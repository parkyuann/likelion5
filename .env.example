# Copy this file to .env and replace the placeholders locally.
# Never commit the real .env file.
KOSIS_API_KEY=replace_me
NCP_CLOVASTUDIO_API_KEY=replace_me

# EC2 application overlay. Real secrets belong only in server-side runtime.env.
APPLICATION_DATABASE_URL=
APPLICATION_SCHEMA_STATUS=VERIFIED
APPLICATION_SCHEMA_REVISION=001_application_auth
REDIS_SESSION_URL=
AUTH_ALLOWED_ORIGINS=https://<pending-domain>
AUTH_SESSION_TTL_SECONDS=604800
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_COOKIE_NAME=__Host-kosis_session
KOSIS_METADATA_DATABASE_URL=
OPENSEARCH_URL=
KOSIS_RELEASE_ID=kosis_canonical_20260821_full_r3_13ko_views
KOSIS_BM25_ANALYZER=standard-v1
KOSIS_BM25_INDEX=kosis_bm25_kosis-canonical-20260821-full-r3-13ko-views_standard-v1_dd4030a92b73
QDRANT_URL=
QDRANT_COLLECTION=kosis_dense_kosis-canonical-20260821-full-r3-13ko-views_dragonkue-bge-m3-ko_kosis-dense-input-document-v1_7074d66aa465_d5bd81613d81
QDRANT_VECTOR_SIZE=1024
QDRANT_RECEIPT_SHA256=<operator-receipt-sha256>
KOSIS_REDIS_CACHE_ENABLED=false
KOSIS_REDIS_CACHE_URL=
BGE_QUERY_ENCODER_ENABLED=false
BGE_RERANKER_ENABLED=false
