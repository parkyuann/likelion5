APP_RUNTIME_MODE=ec2_overlay
APPLICATION_DATABASE_URL=postgresql://application_runtime:<password>@postgres:5432/application
APPLICATION_SCHEMA_STATUS=PENDING_APPLICATION_SCHEMA_RECONCILIATION
APPLICATION_SCHEMA_REVISION=
KOSIS_METADATA_DATABASE_URL=postgresql://kosis_metadata_reader:<password>@postgres:5432/kosis_metadata
REDIS_SESSION_URL=redis://:<password>@redis-session:6379/0
AUTH_ALLOWED_ORIGINS=https://<pending-domain>
AUTH_SESSION_TTL_SECONDS=604800
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_COOKIE_NAME=__Host-kosis_session
OPENSEARCH_URL=http://opensearch:9200
KOSIS_OPENSEARCH_INDEX=<existing-standard-v1-index-name>
QDRANT_URL=http://qdrant:6333
KOSIS_REDIS_CACHE_ENABLED=false
BGE_QUERY_ENCODER_ENABLED=false
BGE_RERANKER_ENABLED=false
