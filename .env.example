# Copy this file to .env and replace the placeholders locally.
# Never commit the real .env file.
KOSIS_API_KEY=replace_me
NCP_CLOVASTUDIO_API_KEY=replace_me

# Required deployment endpoints. Inject real values with AWS Secrets Manager,
# ECS task definitions, Kubernetes Secrets, or the deployment environment.
QDRANT_URL=
BGE_QUERY_ENCODER_URL=
BGE_RERANKER_URL=

# 소셜 로그인(OAuth) — 사용하는 제공자만 채우면 됩니다.
# 로그인 완료 후 돌아갈 프론트 주소(콜백에서 사용).
FRONTEND_ORIGIN=http://localhost:5173

# 구글: Google Cloud Console → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹).
# 승인된 리디렉션 URI에 아래 GOOGLE_REDIRECT_URI를 정확히 등록해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# 카카오
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/v1/auth/kakao/callback

# 네이버
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/v1/auth/naver/callback
